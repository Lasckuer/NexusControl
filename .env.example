# Обязательные переменные окружения
BOT_TOKEN=your_telegram_bot_token_here

# Список Telegram ID администраторов через запятую (или один ADMIN_ID=...)
ADMIN_IDS=123456789,987654321

# Опциональные сетевые настройки
# PROXY_URL=http://user:pass@ip:port
# REDIS_URL=redis://localhost:6379/0
# DB_PATH=database.db
# LOG_LEVEL=INFO
# LOG_FILE=bot_log.log

# Пороги алертов железа (%)
# CPU_THRESHOLD=90.0
# RAM_THRESHOLD=90.0
# DISK_THRESHOLD=95.0
# ALERT_COOLDOWN=3600

# Интервалы проверок в секундах
# REFRESH_INTERVAL=4
# CRASH_MONITOR_INTERVAL=5
# RESOURCE_MONITOR_INTERVAL=30